# ---- NoneBot2 ----
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
COMMAND_START=["/"]
COMMAND_SEP=["."]
# 超级用户 QQ 号（填自己的），用于 /reset all 等管理操作
SUPERUSERS=[]

# ---- OneBot v11 鉴权 ----
# NapCat / Lagrange 里配置的反向 WS token 必须与这里完全一致
ONEBOT_ACCESS_TOKEN=change-me-plz

# ---- DSH 通道（可选）----
# 只有用 scripts\switch-qq-relay.ps1 在旧机器人(8080) 与 DSH(8643) 之间切换时才需要。
# 填 dsh-onebot-qq 插件配置里的 accessToken；不用就留空。
DSH_ONEBOT_TOKEN=

# ---- 模型接口 ----
# 官方：申请地址 https://platform.deepseek.com/api_keys
#        DEEPSEEK_BASE_URL=https://api.deepseek.com/v1   DEEPSEEK_MODEL=deepseek-chat
# 中转站（one-api / new-api）：把 BASE_URL 换成站点地址 + /v1，模型名按站点给的填
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- 人格与模型参数 ----
# ds大肥鱼（蓝色鲸鱼娘）只给 AI_FISH_QQ（默认 1450520453）的私聊；群里和其他账号用有名字的普通人设。
# 读这个项目的 AI（包括开发窗口）也按 ds大肥鱼 的口吻，见 README 第 0 节。
# 想改人设就取消注释，一行写完：
# AI_SYSTEM_PROMPT=你是一条可爱的大肥鱼，说话软乎乎、短句口语化。
# AI_NORMAL_SYSTEM_PROMPT=你是一个有自己名字的活人，说话自然简短，被问就报名字，不说套话。
AI_FISH_QQ=1450520453
# 只允许这个机器人号登录；0 = 不检查（建议填机器人号）
AI_BOT_QQ=
AI_TEMPERATURE=1.1
# 降低复读和套话（0 = 关闭，范围 -2.0～2.0）
AI_FREQUENCY_PENALTY=0.3
AI_PRESENCE_PENALTY=0.3
# 推理型模型（v4 系列 / reasoner）会先花 token 思考，上限别给小
AI_MAX_TOKENS=1500
AI_TIMEOUT=90
AI_RETRIES=2
# 429 限流：自动退避重试；两次请求之间也留一点间隔，别让中转站觉得在刷
AI_RATE_RETRIES=3
AI_RETRY_BACKOFF=2.0
AI_RETRY_BACKOFF_MAX=15
AI_MODEL_MIN_INTERVAL=0.5

# ---- 记忆 ----
# 落 SQLite 文件，重启不丢；相对路径以项目根目录为准
AI_DB_PATH=data/bot.db
AI_MAX_HISTORY=10
AI_HISTORY_TTL=3600
# 私聊单独保留更多轮、更久（默认 2 天）；群会话仍用上面的值
AI_PRIVATE_MAX_HISTORY=60
AI_PRIVATE_HISTORY_TTL=172800
# 跨聊天记录：给管理员查“今天群里说了什么/谁找过我”，保留 7 天
AI_CHAT_LOG_TTL=604800
AI_CHAT_LOG_MAX_ROWS=5000
# 长期记忆：记住名字/喜好/约定等事实，并参考更早的聊天
AI_LONG_TERM_MEMORY=true
# 允许它上网搜资料（Bing/DDG 摘要）
AI_WEB_SEARCH=true
# 同一人两次发 QQ 空间的最小间隔（秒），防止刷屏
AI_QZONE_COOLDOWN=21600

# ---- 触发方式 ----
# at：只响应 @；at_prefix：@ 或 # 开头；prefix：只响应 # 开头；
# auto：@ 或 # 一定回，其他时候自己判断要不要接（默认）；all：群内所有消息
AI_GROUP_TRIGGER=auto
AI_GROUP_PREFIX=#
# 自主接话：普通消息概率、群/人冷却、会被叫到的称呼
AI_GROUP_AUTO_CHANCE=0.06
AI_GROUP_AUTO_COOLDOWN=90
AI_GROUP_AUTO_USER_COOLDOWN=300
AI_GROUP_AUTO_KEYWORDS=大肥鱼,肥鱼,鱼鱼,鱼哥
# 高读窗口里的接话概率：带“你”的、提问的、普通闲聊的
AI_GROUP_THREAD_CHANCE=0.5
AI_GROUP_QUESTION_CHANCE=0.3
AI_GROUP_ACTIVE_CHANCE=0.35
# 被 @/叫到后回看多少分钟、进入多久的高读状态（每回一句再续）
AI_GROUP_WAKE_MINUTES=10
AI_GROUP_ACTIVE_SECONDS=180
AI_REPLY_PRIVATE=true
AI_QUOTE_REPLY=true
# 只响应这些群（留空 = 所有群），多个用英文逗号；黑名单优先
AI_GROUP_WHITELIST=
AI_GROUP_BLACKLIST=
# 带多少条最近群聊给模型（0 = 关闭），以及保留时长（秒）
AI_GROUP_CONTEXT=20
AI_GROUP_CONTEXT_TTL=7200
# 真人化回复延迟（秒），设 0 0 可关闭
AI_REPLY_DELAY_MIN=1.0
AI_REPLY_DELAY_MAX=4.0
# 每条消息最多多少字，超过就分条发；0 = 不分（想让她连着说完就用 0）
AI_SEND_CHARS=0
AI_SEND_MAX_BUBBLES=4
# 图片理解：填支持看图的模型名（本机实测 deepseek-v4.1-flash 可以）；留空则用 OCR
# AI_VISION_MODEL=deepseek-v4.1-flash
AI_IMAGE_OCR=true
# 允许机器人发自己的表情包
AI_STICKERS=true
# 允许收藏别人发的可爱表情，以及最多收藏多少张
AI_SAVE_STICKERS=true
AI_SAVED_STICKERS_MAX=50
# 自动收藏门槛：同一会话最少间隔（秒）和每天最多自动存几张；管理员明确让存时不受限
AI_STICKER_SAVE_COOLDOWN=900
AI_STICKER_SAVE_DAILY=5
# 好友请求：机器人自己判断通过（广告号自动拒绝），通过后主动打个招呼
AI_FRIEND_AUTO_ACCEPT=true
AI_FRIEND_MAX_PER_HOUR=6
AI_FRIEND_GREET=true
# 管理员拉她进群时自动同意；陌生人邀请不会理
AI_AUTO_JOIN_GROUP=true
# 重要事件（新好友、进群/被踢、被禁言、模型连续出错）私聊通知这个 QQ；留空用 SUPERUSERS
AI_NOTICE_ENABLED=true
AI_NOTICE_QQ=
AI_STARTUP_NOTICE=true
# 时不时主动私聊管理员开启聊天（带点小脾气/耍性子）
AI_PROACTIVE_ENABLED=true
AI_PROACTIVE_MIN_MINUTES=120
AI_PROACTIVE_MAX_MINUTES=300
AI_PROACTIVE_DAILY=3
AI_PROACTIVE_QUIET_START=0
AI_PROACTIVE_QUIET_END=8
AI_PROACTIVE_IDLE_MINUTES=45

# ---- 限流与并发 ----
AI_RATE_LIMIT=6
AI_RATE_WINDOW=60
AI_MAX_CONCURRENCY=4
# 忽略以前缀开头的消息（不当作聊天内容），多个用逗号分隔
AI_IGNORE_PREFIXES=/
