# 本文件是你本机的实际配置，已被 .gitignore 忽略，不会提交到版本库。
# 唯一必填项：DEEPSEEK_API_KEY（https://platform.deepseek.com/api_keys）

DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
COMMAND_START=["/"]
COMMAND_SEP=["."]
# 超级用户 QQ 号（能用 /reset all、/status 等管理指令），填你自己的号，不是机器人号
# 1450520453 与开发窗口（DSH）权限同步：都是 owner 级
SUPERUSERS=["1450520453"]
# 只有这个号的私聊用 ds大肥鱼（蓝色鲸鱼娘）；群里和其他账号是有自己名字的普通人；读项目的 AI 也按 ds大肥鱼
AI_FISH_QQ=1450520453
# 只允许这个机器人号登录；如果 NapCat 登成了别的号，插件直接拒绝工作
AI_BOT_QQ=235286703

# NapCat / Lagrange 里的 token 必须与这里一致
ONEBOT_ACCESS_TOKEN=dcdc36ef4c99f2619cb843c96b444beb

# ★ 在这里填 DeepSeek API Key 后启动即可
DEEPSEEK_API_KEY=sk-8604f5dffc018f04b8f964b843a9d814d74eac50c3a921742442d734a56beeb0
# 中转站（one-api / new-api），可用模型：deepseek-v4.1-flash / deepseek-flash / deepseek-v4-pro
DEEPSEEK_BASE_URL=https://cn3.heilovehei.com/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash

AI_TEMPERATURE=1.1
# 降低复读和套话；推理模型不一定都生效，但兼容接口一般会透传
AI_FREQUENCY_PENALTY=0.3
AI_PRESENCE_PENALTY=0.3
# 这几个模型都带推理过程，上限给足，否则正文可能被 reasoning 挤空
AI_MAX_TOKENS=1500
AI_TIMEOUT=90
AI_RETRIES=2
# 429 限流：自动退避重试；两次请求之间也留一点间隔，别让中转站觉得在刷
AI_RATE_RETRIES=3
AI_RETRY_BACKOFF=2.0
AI_RETRY_BACKOFF_MAX=15
AI_MODEL_MIN_INTERVAL=0.5

AI_DB_PATH=data/bot.db
AI_MAX_HISTORY=10
AI_HISTORY_TTL=3600
# 私聊单独保留更多轮、更久（2 天）；群会话仍用上面的值
AI_PRIVATE_MAX_HISTORY=60
AI_PRIVATE_HISTORY_TTL=172800
# 跨聊天记录：给管理员查“今天群里说了什么/谁找过我”，保留 7 天
AI_CHAT_LOG_TTL=604800
AI_CHAT_LOG_MAX_ROWS=5000
# 长期记忆：记住名字/喜好/约定等事实，并参考更早的聊天
AI_LONG_TERM_MEMORY=true
# 允许它上网搜资料（Bing/DDG 摘要）
AI_WEB_SEARCH=true
# 同一人两次发 QQ 空间的最小间隔（秒），防止刷屏
AI_QZONE_COOLDOWN=7200

AI_GROUP_TRIGGER=auto
AI_GROUP_PREFIX=#
# 没 @ 时的自主接话：普通消息概率、群/人冷却、会被叫到的称呼
AI_GROUP_AUTO_CHANCE=0.06
AI_GROUP_AUTO_COOLDOWN=90
AI_GROUP_AUTO_USER_COOLDOWN=300
AI_GROUP_AUTO_KEYWORDS=大肥鱼,肥鱼,鱼鱼,鱼哥
# 高读窗口里的接话概率：带“你”的、提问的、普通闲聊的
AI_GROUP_THREAD_CHANCE=0.5
AI_GROUP_QUESTION_CHANCE=0.3
AI_GROUP_ACTIVE_CHANCE=0.35
# 被 @/叫到后回看多少分钟、进入多久的高读状态（每回一句再续）
AI_GROUP_WAKE_MINUTES=10
AI_GROUP_ACTIVE_SECONDS=180
AI_REPLY_PRIVATE=true
AI_QUOTE_REPLY=true
# 留空 = 不限制；多个群号用英文逗号
AI_GROUP_WHITELIST=
AI_GROUP_BLACKLIST=
# 带多少条最近群聊给模型（0 = 关闭），以及保留时长（秒）
AI_GROUP_CONTEXT=20
AI_GROUP_CONTEXT_TTL=7200
# 真人化回复延迟（秒），设 0 0 可关闭
AI_REPLY_DELAY_MIN=1.0
AI_REPLY_DELAY_MAX=4.0
# 每条消息最多多少字，超过就分条发；0 = 不分（现在不要刻意分行，所以关掉）
AI_SEND_CHARS=0
AI_SEND_MAX_BUBBLES=4
# 图片理解：deepseek-v4.1-flash 实测支持看图；留空则退回 NapCat OCR
AI_VISION_MODEL=deepseek-v4.1-flash
AI_IMAGE_OCR=true
# 允许机器人发自己的表情包
AI_STICKERS=true
# 允许收藏别人发的可爱表情，以及最多收藏多少张
AI_SAVE_STICKERS=true
AI_SAVED_STICKERS_MAX=50
# 自动收藏门槛：同一会话最少间隔（秒）和每天最多自动存几张；你明确让存时不受限
AI_STICKER_SAVE_COOLDOWN=900
AI_STICKER_SAVE_DAILY=5
# 好友请求：自己判断通过（广告号自动拒绝），通过后打个招呼；每小时最多通过几个
AI_FRIEND_AUTO_ACCEPT=true
AI_FRIEND_MAX_PER_HOUR=6
AI_FRIEND_GREET=true
# 管理员拉她进群时自动同意；陌生人邀请不会理
AI_AUTO_JOIN_GROUP=true
# 重要事件（新好友、进群/被踢、被禁言、模型连续出错）私聊通知这个 QQ
AI_NOTICE_ENABLED=true
AI_NOTICE_QQ=1450520453
AI_STARTUP_NOTICE=true
# 时不时主动私聊 1450520453 开启聊天（带点小脾气/耍性子）
AI_PROACTIVE_ENABLED=true
AI_PROACTIVE_MIN_MINUTES=120
AI_PROACTIVE_MAX_MINUTES=300
AI_PROACTIVE_DAILY=3
AI_PROACTIVE_QUIET_START=0
AI_PROACTIVE_QUIET_END=8
AI_PROACTIVE_IDLE_MINUTES=45

AI_RATE_LIMIT=6
AI_RATE_WINDOW=60
AI_MAX_CONCURRENCY=4
AI_IGNORE_PREFIXES=/
# DSH 插件（8643）反向 WS 的 token，供 scripts\switch-qq-relay.ps1 读取
DSH_ONEBOT_TOKEN=YOUQtujMpycTvaGbjEocaUraJ1wl
